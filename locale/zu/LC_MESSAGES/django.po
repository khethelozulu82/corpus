# ── Home page ──────────────────────────────────────────────────────────
msgid "YOUR CULTURAL LIBRARY"
msgstr "ILAYIBRARI YAKHO YAMASIKO"

msgid "Welcome, %(name)s. Continue exploring isiZulu language and culture."
msgstr "Siyakwamukela, %(name)s. Qhubeka uhlola ulimi lwesiZulu namasiko."

msgid "Explore language."
msgstr "Hlola ulimi."

msgid "Connect with culture."
msgstr "Xhumana namasiko."

msgid "A space for isiZulu words, their English meanings, and the cultural stories that connect them."
msgstr "Indawo yamagama esiZulu, izincazelo zawo zesiNgisi, kanye nezindaba zamasiko ezixhumanisa wona."

msgid "Search an isiZulu word or English meaning"
msgstr "Sesha igama lesiZulu noma incazelo yesiNgisi"

msgid "Keep the words you want to return to."
msgstr "Gcina amagama ofuna ukuwabuyela kuwo."

msgid "Explore the culture behind the language."
msgstr "Hlola amasiko angemuva kolimi."

msgid "Explore Cultural Stories"
msgstr "Hlola Izindaba Zamasiko"

msgid "Discover searches and corpus statistics."
msgstr "Thola izibalo zokusesha nekhophasi."

msgid "View Trends"
msgstr "Buka Izitayela"

msgid "Your Search History"
msgstr "Umlando Wakho Wokusesha"

msgid "View History"
msgstr "Buka Umlando"

msgid "No searches yet. Start exploring the corpus!"
msgstr "Akukho okuseshiwe okwamanje. Qala ukuhlola ikhophasi!"

msgid "result"
msgid_plural "results"
msgstr[0] "umphumela"
msgstr[1] "imiphumela"

# ── Search page ────────────────────────────────────────────────────────
msgid "EXPLORE THE CORPUS"
msgstr "HLOLE IKHOPHASI"

msgid "Find isiZulu words and expressions, with their English meanings side by side."
msgstr "Thola amagama nezisho zesiZulu, kanye nezincazelo zazo zesiNgisi eceleni."

msgid "Search for a word, phrase or meaning…"
msgstr "Sesha igama, ibinzana noma incazelo…"

msgid "Search in"
msgstr "Sesha ku"

msgid "IsiZulu"
msgstr "IsiZulu"

msgid "Both languages"
msgstr "Zombili izilimi"

msgid "Search a word or part of an expression."
msgstr "Sesha igama noma ingxenye yesisho."

msgid "Listen to a word · Save with the star"
msgstr "Lalela igama · Gcina ngenkanyezi"

msgid "English meaning"
msgstr "Incazelo yesiNgisi"

msgid "No results for"
msgstr "Ayikho imiphumela ye"

msgid "Did you mean:"
msgstr "Ube uqonde:"

msgid "Check the spelling, or try a different language."
msgstr "Hlola isipelingi, noma uzame olunye ulimi."

msgid "Hear the pronunciation"
msgstr "Zwa ukuphimisela"

msgid "Use the speaker icon next to an isiZulu word. Pronunciation may not always be accurate."
msgstr "Sebenzisa isithonjana sesipikha eduze kwegama lesiZulu. Ukuphimisela kungase kungabi ncophelela ngaso sonke isikhathi."

msgid "Download the Corpus Database"
msgstr "Landa Isizindalwazi Sekhophasi"

msgid "Download the complete database as a JSON file (requires login)."
msgstr "Landa isizindalwazi esiphelele njengefayela le-JSON (kudinga ukungena)."

msgid "Download Database"
msgstr "Landa Isizindalwazi"

# ── History page ───────────────────────────────────────────────────────
msgid "PICK UP WHERE YOU LEFT OFF"
msgstr "QHUBEKA LAPHO USHIYE KHONA"

msgid "Your %(count)s most recent distinct searches. Searching the same term again moves it to the top instead of adding a duplicate."
msgstr "Izinto zakho ezingu-%(count)s ezisanda kuseshwa ezihlukile. Ukusesha igama elifanayo futhi kuyisa phezulu esikhundleni sokwengeza okufanayo."

msgid "Clear All History"
msgstr "Sula Wonke Umlando"

msgid "Found"
msgstr "Kutholakale"

msgid "Search Again"
msgstr "Sesha Futhi"

msgid "Remove"
msgstr "Susa"

msgid "No results were found for this search."
msgstr "Ayikho imiphumela eyatholakala kulokhu kusesha."

msgid "Your search history is empty."
msgstr "Umlando wakho wokusesha awunalutho."

msgid "Start exploring the"
msgstr "Qala ukuhlola"

msgid "corpus"
msgstr "ikhophasi"

msgid "to build your history!"
msgstr "ukwakha umlando wakho!"

msgid "History is private to your account and keeps your 5 most recent distinct searches. Remove a single entry or clear your whole history."
msgstr "Umlando uyimfihlo ye-akhawunti yakho futhi ugcina izinto zakho ezi-5 ezisanda kuseshwa ezihlukile. Susa into eyodwa noma usule wonke umlando wakho."

# ── Trends page ────────────────────────────────────────────────────────
msgid "A LOOK AT THE CORPUS"
msgstr "UKUBHEKA IKHOPHASI"

msgid "Corpus Statistics And Trends"
msgstr "Izibalo Nezitayela Zekhophasi"

msgid "Explore overall corpus statistics, frequently searched words and common word pairs."
msgstr "Hlola izibalo zekhophasi iyonke, amagama avame ukuseshwa kanye namagama amabili avamile."

msgid "Total Words"
msgstr "Amagama Ewonke"

msgid "Total Phrases"
msgstr "Imisho Ewonke"

msgid "Total Users"
msgstr "Abasebenzisi Abonke"

msgid "Total Searches"
msgstr "Ukusesha Okuphelele"

msgid "Most Frequent Words"
msgstr "Amagama Avame Kakhulu"

msgid "Search counts for the most frequent entries in the table below."
msgstr "Izibalo zokusesha zezinto ezivame kakhulu kuthebula elingezansi."

msgid "Search Frequency"
msgstr "Imvamisa Yokusesha"

msgid "Word Statistics"
msgstr "Izibalo Zamagama"

msgid "displayed entries"
msgstr "izinto ezibonisiwe"

msgid "Word · IsiZulu"
msgstr "Igama · IsiZulu"

msgid "Translation · English"
msgstr "Ukuhumusha · IsiNgisi"

msgid "Search Count"
msgstr "Inani Lokusesha"

msgid "Part of Speech"
msgstr "Ingxenye Yenkulumo"

msgid "Common Word Pairs"
msgstr "Amagama Amabili Avamile"

msgid "Words that have appeared together in the same search results."
msgstr "Amagama avela ndawonye emiphumeleni yokusesha efanayo."

msgid "Word 1"
msgstr "Igama 1"

msgid "Word 2"
msgstr "Igama 2"

msgid "Frequency"
msgstr "Imvamisa"

msgid "No word pairs recorded yet — search for a term that matches more than one word to build this table."
msgstr "Awekho amagama amabili aqoshiwe okwamanje — sesha igama elihambisana namagama angaphezu kwelilodwa ukwakha leli thebula."

msgid "No data available."
msgstr "Ayikho idatha etholakalayo."

msgid "No search data yet."
msgstr "Ayikho idatha yokusesha okwamanje."

# ── Help page ──────────────────────────────────────────────────────────
msgid "MAKE THE MOST OF THE CORPUS"
msgstr "SEBENZISA IKHOPHASI NGEZONKE IZINDLELA"

msgid "A simple guide to pronunciation, favourites, trends and your search history."
msgstr "Umhlahlandlela olula wokuphimisela, izintandokazi, izitayela nomlando wakho wokusesha."

msgid "Pronunciation"
msgstr "Ukuphimisela"

msgid "Click the speaker icon next to any isiZulu word to hear its pronunciation. For best results:"
msgstr "Chofoza isithonjana sesipikha eduze kwanoma yiliphi igama lesiZulu ukuzwa ukuphimisela kwalo. Ukuze uthole imiphumela emihle:"

msgid "Use a modern browser that supports speech synthesis."
msgstr "Sebenzisa isiphequluli sesimanje esisekela ukwakhiwa kwenkulumo."

msgid "Ensure your volume is turned on."
msgstr "Qiniseka ukuthi ivolumu yakho ivuliwe."

msgid "isiZulu voices may not be available in all browsers."
msgstr "Amazwi esiZulu kungenzeka angatholakali kuzo zonke iziphequluli."

msgid "Please note that the pronunciation may not always be accurate."
msgstr "Sicela uqaphele ukuthi ukuphimisela kungase kungabi ncophelela ngaso sonke isikhathi."

msgid "Saving Favourites"
msgstr "Ukugcina Izintandokazi"

msgid "Click the star icon next to any word to add it to your favourites. You can:"
msgstr "Chofoza isithonjana senkanyezi eduze kwanoma yiliphi igama ukuze ulengeze ezintandokazini zakho. Ungakwenza:"

msgid "Access your favourites from the Favourites page."
msgstr "Finyelela izintandokazi zakho kusukela ekhasini lezintandokazi."

msgid "Remove words by clicking the star again."
msgstr "Susa amagama ngokuchofoza inkanyezi futhi."

msgid "Use favourites to build your personal vocabulary list."
msgstr "Sebenzisa izintandokazi ukwakha uhlu lwakho lwamagama."

msgid "Select the star to save a word"
msgstr "Khetha inkanyezi ukugcina igama"

msgid "Viewing Trends"
msgstr "Ukubuka Izitayela"

msgid "The Trends page shows statistics about the corpus:"
msgstr "Ikhasi lezitayela libonisa izibalo mayelana nekhophasi:"

msgid "Most frequently searched words."
msgstr "Amagama avame ukuseshwa kakhulu."

msgid "Common word pairs."
msgstr "Amagama amabili avamile."

msgid "Overall corpus statistics."
msgstr "Izibalo zekhophasi iyonke."

msgid "Search History"
msgstr "Umlando Wokusesha"

msgid "The History page keeps your 5 most recent distinct searches, newest first. Searching the same term again moves it to the top rather than adding a duplicate."
msgstr "Ikhasi lomlando ligcina izinto zakho ezi-5 ezisanda kuseshwa ezihlukile, ezintsha kuqala. Ukusesha igama elifanayo futhi kuyisa phezulu esikhundleni sokwengeza okufanayo."

msgid "You can remove a single entry or clear your whole history. History is private to your account."
msgstr "Ungasusa into eyodwa noma usule wonke umlando wakho. Umlando uyimfihlo ye-akhawathi yakho."

msgid "Downloading the Corpus"
msgstr "Ukulanda Ikhophasi"

msgid "The corpus is available as a JSON file. You need to be logged in to download it."
msgstr "Ikhophasi itholakala njengefayela le-JSON. Udinga ukungena ukuze uyilande."

msgid "Download Corpus"
msgstr "Landa Ikhophasi"

