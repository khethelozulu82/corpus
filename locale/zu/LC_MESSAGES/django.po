msgid "Not provided"
msgstr "Ayikunikezwanga"

msgid "Your history stays yours"
msgstr "Umlando wakho uhlala ungowakho"

msgid "Search history is private to your account. You can remove entries from History at any time."
msgstr "Umlando wokusesha uyimfihlo ye-akhawunti yakho. Ungasusa izinto kuMlando noma nini."

msgid "Logout"
msgstr "Phuma"

msgid "Your Activity"
msgstr "Umsebenzi Wakho"

msgid "Favourite Words"
msgstr "Amagama Ayizintandokazi"

msgid "Searches"
msgstr "Ukusesha"

msgid "Recent Activity"
msgstr "Umsebenzi Wakamuva"

msgid "Searched for"
msgstr "Kuseshwe"

msgid "No recent activity to display."
msgstr "Awukho umsebenzi wakamuva ozoboniswa."

# ── Favourites page ────────────────────────────────────────────────────
msgid "YOUR SAVED WORDS"
msgstr "AMAGAMA AKHO AGCIWE"

msgid "Words you've saved for later. Tap the star to remove them."
msgstr "Amagama owagcine kamuva. Thepha inkanyezi ukuwasusa."

msgid "Search your favourites…"
msgstr "Sesha ezintandokazini zakho…"

msgid "Search favourites"
msgstr "Sesha izintandokazi"

msgid "favourite word"
msgid_plural "favourite words"
msgstr[0] "igama eliyintandokazi"
msgstr[1] "amagama ayizintandokazi"

msgid "No favourites match"
msgstr "Azikho izintandokazi ezihambisana ne"

msgid "Clear search"
msgstr "Sula ukusesha"

msgid "to see all your favourites."
msgstr "ukubona zonke izintandokazi zakho."

msgid "No Favourites Yet"
msgstr "Azikho Izintandokazi Okwamanje"

msgid "You haven't added any words to your favourites yet."
msgstr "Awukangeze wengeza amagama ezintandokazini zakho."

msgid "Start exploring the"
msgstr "Qala ukuhlola"

msgid "to find words to save!"
msgstr "ukuthola amagama okuwagcina!"

# ── Cultural stories page ──────────────────────────────────────────────
msgid "STORIES BEHIND THE LANGUAGE"
msgstr "IZINDABA EZINGEMUVA KOLIMI"

msgid "Traditional foods, wild fruits, ceremonies, and the life of the Zulu people in the past."
msgstr "Ukudla kwendabuko, izithelo zasendle, imicimbi, kanye nempilo yabantu bakwaZulu emandulo."

msgid "Download the Cultural Stories Document"
msgstr "Landa Idokhumenti Yezindaba Zamasiko"

msgid "Includes content in isiZulu, English, Sesotho and Siswati."
msgstr "Kuhlanganisa okuqukethwe ngesiZulu, isiNgisi, iSesotho nesiSwati."

msgid "Download Cultural Stories (DOCX)"
msgstr "Landa Izindaba Zamasiko (DOCX)"

# ── Auth pages ─────────────────────────────────────────────────────────
msgid "Sign in to access your favourites, history and personal library."
msgstr "Ngena ukuze ufinyelele izintandokazi zakho, umlando kanye nelayibrari yakho sibo."

msgid "Your username and password didn't match. Please try again."
msgstr "Igama lakho lomsebenzisi nephasiwedi azihambisani. Sicela uzame futhi."

msgid "Password"
msgstr "Iphasiwedi"

msgid "Don't have an account?"
msgstr "Awunayo i-akhawunti?"

msgid "Register here"
msgstr "Bhalisa lapha"

msgid "Create an account to save favourites and track your searches."
msgstr "Dala i-akhawunti ukugcina izintandokazi nokulandelela ukusesha kwakho."

msgid "Please correct the errors below."
msgstr "Sicela ulungise amaphutha angezansi."

msgid "Password Confirmation"
msgstr "Ukuqinisekiswa KwePhasiwedi"

msgid "Already have an account?"
msgstr "Usunayo i-akhawunti?"

msgid "Login here"
msgstr "Ngena lapha"

